<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/cancel"
            android:textColor="@color/ios_blue"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvEditorTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/ios_label"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/save"
            android:textColor="@color/ios_blue"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <EditText
                android:id="@+id/etName"
                style="@style/IOSField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_field"
                android:hint="@string/rule_name_hint"
                android:inputType="text" />

            <!-- SENDER -->
            <TextView
                style="@style/IOSSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sec_sender" />

            <EditText
                android:id="@+id/etSender"
                style="@style/IOSField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_field"
                android:hint="@string/sender_hint"
                android:inputType="text" />

            <Button
                android:id="@+id/btnPickSender"
                style="@style/IOSTextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pick_sender" />

            <!-- FILTER -->
            <TextView
                style="@style/IOSSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sec_filter" />

            <EditText
                android:id="@+id/etKeyword"
                style="@style/IOSField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_field"
                android:hint="@string/keyword_hint"
                android:inputType="text" />

            <EditText
                android:id="@+id/etRegex"
                style="@style/IOSField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_field"
                android:fontFamily="monospace"
                android:hint="@string/regex_hint"
                android:inputType="textNoSuggestions" />

            <Button
                android:id="@+id/btnTestRegex"
                style="@style/IOSTextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_test_regex" />

            <!-- ACTION -->
            <TextView
                style="@style/IOSSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sec_action" />

            <TextView
                android:id="@+id/tvAction"
                style="@style/IOSField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_field"
                android:clickable="true"
                android:focusable="true" />

            <!-- SMS to a number -->
            <LinearLayout
                android:id="@+id/smsBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/IOSSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sec_forward" />

                <EditText
                    android:id="@+id/etDest"
                    style="@style/IOSField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_field"
                    android:hint="@string/dest_hint"
                    android:inputType="phone" />

                <Button
                    android:id="@+id/btnPickDest"
                    style="@style/IOSTextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pick_contact" />
            </LinearLayout>

            <!-- API server -->
            <include
                android:id="@+id/apiBox"
                layout="@layout/layout_api_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
