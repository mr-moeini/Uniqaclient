<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/cancel"
            android:textColor="@color/ios_blue"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvEditorTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/ios_label"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/save"
            android:textColor="@color/ios_blue"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">


            <EditText
                android:id="@+id/etName"
                style="@style/IOSField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_field"
                android:hint="@string/rule_name_hint"
                android:inputType="text" />

            <TextView
                style="@style/IOSSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sec_measure" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swCpu"
                style="@style/IOSSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_field"
                android:padding="14dp"
                android:text="@string/m_cpu"
                android:textColor="@color/ios_label"
                android:textSize="16sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swRam"
                style="@style/IOSSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_field"
                android:padding="14dp"
                android:text="@string/m_ram"
                android:textColor="@color/ios_label"
                android:textSize="16sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swDisk"
                style="@style/IOSSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_field"
                android:padding="14dp"
                android:text="@string/m_disk"
                android:textColor="@color/ios_label"
                android:textSize="16sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swIp"
                style="@style/IOSSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_field"
                android:padding="14dp"
                android:text="@string/m_ip"
                android:textColor="@color/ios_label"
                android:textSize="16sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swInternet"
                style="@style/IOSSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_field"
                android:padding="14dp"
                android:text="@string/m_internet"
                android:textColor="@color/ios_label"
                android:textSize="16sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swPing"
                style="@style/IOSSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_field"
                android:padding="14dp"
                android:text="@string/m_ping"
                android:textColor="@color/ios_label"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/pingBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <EditText
                android:id="@+id/etPingHosts"
                style="@style/IOSField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_field"
                android:hint="@string/ping_hosts_hint"
                android:inputType="textNoSuggestions"
                android:textDirection="ltr" />

            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swUssd"
                style="@style/IOSSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_field"
                android:padding="14dp"
                android:text="@string/m_ussd"
                android:textColor="@color/ios_label"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/ussdBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <EditText
                android:id="@+id/etUssdCode"
                style="@style/IOSField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_field"
                android:hint="@string/ussd_code_hint"
                android:inputType="phone"
                android:textDirection="ltr" />

            <EditText
                android:id="@+id/etUssdRegex"
                style="@style/IOSField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_field"
                android:hint="@string/ussd_regex_hint"
                android:fontFamily="monospace"
                android:inputType="textNoSuggestions"
                android:textDirection="ltr" />

            </LinearLayout>

            <TextView
                style="@style/IOSSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sec_schedule" />

            <EditText
                android:id="@+id/etInterval"
                style="@style/IOSField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_field"
                android:hint="@string/interval_hint"
                android:inputType="number"
                android:maxLength="5" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swDates"
                style="@style/IOSSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_field"
                android:padding="14dp"
                android:text="@string/dates_limit"
                android:textColor="@color/ios_label"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/dateBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDateFrom"
                    style="@style/IOSField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_field"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tvDateTo"
                    style="@style/IOSField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_field"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                style="@style/IOSSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sec_content" />

            <EditText
                android:id="@+id/etRegex"
                style="@style/IOSField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_field"
                android:fontFamily="monospace"
                android:hint="@string/regex_hint"
                android:inputType="textNoSuggestions" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTestRegex"
                    style="@style/IOSTextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_test_regex" />

                <Button
                    android:id="@+id/btnPreview"
                    style="@style/IOSTextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_preview" />
            </LinearLayout>

            <TextView
                style="@style/IOSSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sec_action" />

            <TextView
                android:id="@+id/tvAction"
                style="@style/IOSField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_field"
                android:clickable="true"
                android:focusable="true" />

            <!-- SMS to a number -->
            <LinearLayout
                android:id="@+id/smsBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/IOSSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sec_forward" />

                <EditText
                    android:id="@+id/etDest"
                    style="@style/IOSField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_field"
                    android:hint="@string/dest_hint"
                    android:inputType="phone" />

                <Button
                    android:id="@+id/btnPickDest"
                    style="@style/IOSTextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pick_contact" />
            </LinearLayout>

            <!-- API server -->
            <include
                android:id="@+id/apiBox"
                layout="@layout/layout_api_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnSendNow"
                style="@style/IOSTextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/btn_send_now" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
